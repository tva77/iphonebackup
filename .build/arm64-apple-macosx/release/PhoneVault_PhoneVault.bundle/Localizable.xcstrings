{
  "sourceLanguage": "en",
  "strings": {
    "untested.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Untested iOS version"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Versão do iOS não testada"
          }
        }
      }
    },
    "untested.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This iOS version has not been tested with PhoneVault. Continue at your own risk?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versão do iOS não foi testada com o PhoneVault. Continuar por sua conta e risco?"
          }
        }
      }
    },
    "untested.continue": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuar"
          }
        }
      }
    },
    "progress.cancel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelar"
          }
        }
      }
    },
    "progress.keptPrevious": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The previous valid backup was kept."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O backup válido anterior foi mantido."
          }
        }
      }
    },
    "device.used": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used space"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Espaço usado"
          }
        }
      }
    },
    "device.chooseFolder": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose folder…"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolher pasta…"
          }
        }
      }
    },
    "device.none": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No backup yet"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum backup ainda"
          }
        }
      }
    },
    "device.backupNow": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back up now"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fazer backup agora"
          }
        }
      }
    },
    "device.noDestination": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a destination folder first."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha primeiro uma pasta de destino."
          }
        }
      }
    },
    "device.lastBackup": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup"
          }
        }
      }
    },
    "onboarding.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect your iPhone"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte seu iPhone"
          }
        }
      }
    },
    "onboarding.connect": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect the iPhone with a cable, unlock it and tap Trust."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte o iPhone com cabo, desbloqueie-o e toque em Confiar."
          }
        }
      }
    },
    "pairing.retry": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tentar novamente"
          }
        }
      }
    },
    "pairing.locked": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock the iPhone and try again."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloqueie o iPhone e tente de novo."
          }
        }
      }
    },
    "pairing.denied": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trust was declined. Unlock the iPhone and tap Trust."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A confiança foi recusada. Desbloqueie o iPhone e toque em Confiar."
          }
        }
      }
    },
    "pairing.needsTrust": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Trust on the iPhone and enter the passcode."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em Confiar no iPhone e digite o código."
          }
        }
      }
    },
    "encryption.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Encryption"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Criptografia"
          }
        }
      }
    },
    "encryption.toggle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Encrypt backup"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Criptografar backup"
          }
        }
      }
    },
    "encryption.excluded": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without encryption, saved passwords, Health data and other sensitive items are not included."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem criptografia, senhas salvas, dados de Saúde e outros itens sensíveis não são incluídos."
          }
        }
      }
    },
    "encryption.warning": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you lose the password, this backup cannot be recovered."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se você perder a senha, este backup não poderá ser recuperado."
          }
        }
      }
    },
    "encryption.saveKeychain": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save password in Keychain"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardar senha no Keychain"
          }
        }
      }
    },
